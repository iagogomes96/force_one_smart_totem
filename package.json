    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
